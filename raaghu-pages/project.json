{
    "name": "raaghu-pages",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "raaghu-pages/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "@nrwl/js:tsc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "dist/raaghu-pages",
          "main": "raaghu-pages/src/index.ts",
          "tsConfig": "raaghu-pages/tsconfig.json",
          "assets": ["raaghu-pages/*.md"]
        }
      },
      "lint": {
        "executor": "@nrwl/linter:eslint",
        "outputs": ["{options.outputFile}"],
        "options": {
          "lintFilePatterns": ["raaghu-pages/**/*.ts"]
        }
      },
      "test": {
        "executor": "@nrwl/jest:jest",
        "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
        "options": {
          "jestConfig": "raaghu-pages/jest.config.ts",
          "passWithNoTests": true
        }
      }
    },
    "tags": []
  }