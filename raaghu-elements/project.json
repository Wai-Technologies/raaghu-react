{
  "name": "raaghu-elements",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "raaghu-elements/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/raaghu-elements",
        "main": "raaghu-elements/src/index.ts",
        "tsConfig": "raaghu-elements/tsconfig.json",
        "assets": ["raaghu-elements/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["raaghu-elements/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "raaghu-elements/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}