{
  "name": "@waiin/raaghu-react",
  "version": "1.3.1",
  "description": "@waiin/raaghu-react is an React based design system from Raaghu Design System built on top of MUI and Fluent UI. @waiin/raaghu-react employs React, Typescript, Vite, Millions and Storybook features to develop highly customizable UI components and pages, that provides application shells, layouts, elements, components, map and charts.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "millionjs",
    "bootstrap",
    "storybook",
    "raaghu",
    "rds-generator",
    "@waiin/raaghu-react",
    "raaghu-elements-themes",
    "raaghu-components-themes",
    "raaghu-layout-themes",
    "raaghu-appshell-themes",
    "wai-technologies",
    "utility",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wai-Technologies/raaghu-react"
  },
  "author": {
    "name": "Wai Technologies",
    "email": "support@waiin.com",
    "url": "https://waiin.com"
  },
  "homepage": "https://waiin.com/raaghu-open-source-design-system",
  "license": "Apache License 2.0",
  "main": "./dist/raaghu-react.umd.js",
  "module": "./dist/raaghu-react.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/raaghu-react.es.js",
      "require": "./dist/raaghu-react.umd.js"
    }
  },
  "sideEffects": false,
  "workspaces": [
    "raaghu-pages"
  ],
  "files": [
    "raaghu-components/",
    "raaghu-elements/",
    "raaghu-layouts/",
    "raaghu-react-themes/",
    "utils/",
    "index.ts",
    "README.md",
    "LICENSE",
    "!**/*.stories.*",
    "!**/*.story.*",
    "!**/.storybook/",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/stories/"
  ],
  "scripts": {
    "generate": "plop",
    "health": "node scripts/collect-health-data.js",
    "health:check": "node scripts/health-check.js",
    "size": "size-limit",
    "dev": "bun run vite",
    "build": "bun run tsc -b && bun run vite build",
    "build:lib": "bun run tsc -b && bun run vite build",
    "lint": "bun run eslint .",
    "preview": "bun run vite preview",
    "test": "bun run jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:visual": "storybook test-runner",
    "test:visual:update": "playwright test tests/specs/visual/branch-compare.spec.ts --update-snapshots",
    "test:visual:smoke": "playwright test tests/specs/visual/branch-compare.spec.ts --grep \"smoke\"",
    "test:watch": "bun run jest --watch",
    "test:coverage": "bun run jest --coverage",
    "test:accessibility": "bun run jest --testPathPattern=accessibility",
    "test:storybook": "vitest",
    "test:ui": "vitest --ui",
    "test:storybook:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "bun run chromatic --project-token=chpt_e0908206295b243",
    "chromatic:build": "npm run build-storybook && bun run chromatic --project-token=chpt_e0908206295b243",
    "chromatic:test": "bun run chromatic --project-token=chpt_e0908206295b243 --exit-once-uploaded",
    "pages": "bun run --filter raaghu-pages dev",
    "pages:dev": "bun run --filter raaghu-pages dev",
    "pages:build": "bun run --filter raaghu-pages build",
    "pages:lint": "bun run --filter raaghu-pages lint",
    "pages:preview": "bun run --filter raaghu-pages preview",
    "install:bun": "bun install",
    "clean": "bun run rimraf node_modules dist storybook-static bun.lock",
    "clean:install": "bun run clean && bun install",
    "type-check": "bun run tsc --noEmit",
    "type-check:all": "tsc --noEmit --project tsconfig.library.json",
    "prepublishOnly": "npm run build",
    "test:visual:all": "playwright test tests/specs/visual/branch-compare.spec.ts --grep \"all Default\"",
    "test:visual:all:update": "playwright test tests/specs/visual/branch-compare.spec.ts --grep \"all Default\" --update-snapshots"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@figma/code-connect": "^1.3.4",
    "@griffel/react": "^1.5.30",
    "@mui/icons-material": "^7.2.0",
    "@mui/lab": "^7.0.0-beta.14",
    "@mui/system": "^7.3.1",
    "@mui/x-data-grid": "^8.10.1",
    "@mui/x-date-pickers": "^8.10.2",
    "@popperjs/core": "^2.11.8",
    "@testing-library/dom": "^10.4.1",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-measure": "^2.0.12",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "draft-js": "^0.11.7",
    "draftjs-to-html": "^0.9.1",
    "emojibase": "^16.0.0",
    "emojibase-data": "^16.0.3",
    "html-to-draftjs": "^1.5.0",
    "immutable": "^4.3.8",
    "lottie-react": "^2.4.1",
    "million": "^3.1.11",
    "react-color": "^2.19.3",
    "react-datepicker": "^8.4.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-measure": "^2.5.2",
    "react-player": "^2.13.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.8.1",
    "react-svg-worldmap": "^2.0.0-alpha.16",
    "react-syntax-highlighter": "^15.5.0",
    "rimraf": "^6.0.1",
    "slate": "^0.123.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.117.4"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite-plugin-dts": "^3.9.1",
    "@eslint/js": "^9.30.1",
    "@griffel/vite-plugin": "^0.1.13",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-coverage": "^3.0.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/mcp": "^0.7.0",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/chart.js": "^2.9.41",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/runner": "^4.1.7",
    "axe-core": "^4.8.4",
    "chalk": "^5.3.0",
    "chromatic": "^13.1.3",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.4.1",
    "fs-extra": "^11.2.0",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "inquirer": "^10.2.2",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "plop": "^4.0.5",
    "remark-gfm": "^4.0.1",
    "sass": "^1.89.2",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.1",
    "ts-jest": "^29.1.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "sass-embedded": "npm:sass@^1.89.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@mui/material": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "size-limit": [
    {
      "name": "Elements (all)",
      "path": "raaghu-elements/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Components (all)",
      "path": "raaghu-components/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Themes",
      "path": "raaghu-react-themes/tokens/design-tokens.ts",
      "limit": "50 kB",
      "import": "*"
    }
  ]
}
