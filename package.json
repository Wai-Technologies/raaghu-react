{
  "name": "@waiin/raaghu-react",
  "version": "3.0.0",
  "description": "@waiin/raaghu-react is a React design system from the Raaghu Design System, built on MUI. It uses React, TypeScript, Vite and Storybook to provide customizable application shells, layouts, elements, components, maps and charts.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "storybook",
    "raaghu",
    "rds-generator",
    "@waiin/raaghu-react",
    "raaghu-elements-themes",
    "raaghu-components-themes",
    "raaghu-layout-themes",
    "raaghu-appshell-themes",
    "wai-technologies",
    "utility",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wai-Technologies/raaghu-react"
  },
  "author": {
    "name": "Wai Technologies",
    "email": "support@waiin.com",
    "url": "https://waiin.com"
  },
  "homepage": "https://waiin.com/raaghu-open-source-design-system",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/raaghu-react.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/raaghu-react.css",
    "./raaghu-react.css": "./dist/raaghu-react.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.mjs",
      "require": "./dist/charts.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.mjs",
      "require": "./dist/editor.cjs"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.mjs",
      "require": "./dist/date.cjs"
    },
    "./kanban": {
      "types": "./dist/kanban.d.ts",
      "import": "./dist/kanban.mjs",
      "require": "./dist/kanban.cjs"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.mjs",
      "require": "./dist/timeline.cjs"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.mjs",
      "require": "./dist/video.cjs"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.mjs",
      "require": "./dist/map.cjs"
    },
    "./lottie": {
      "types": "./dist/lottie.d.ts",
      "import": "./dist/lottie.mjs",
      "require": "./dist/lottie.cjs"
    },
    "./raaghu-react-themes/src/styles/index.scss": "./raaghu-react-themes/src/styles/index.scss",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "charts": [
        "./dist/charts.d.ts"
      ],
      "editor": [
        "./dist/editor.d.ts"
      ],
      "date": [
        "./dist/date.d.ts"
      ],
      "kanban": [
        "./dist/kanban.d.ts"
      ],
      "timeline": [
        "./dist/timeline.d.ts"
      ],
      "video": [
        "./dist/video.d.ts"
      ],
      "map": [
        "./dist/map.d.ts"
      ],
      "lottie": [
        "./dist/lottie.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/raaghu-react.css"
  ],
  "workspaces": [
    "raaghu-pages"
  ],
  "files": [
    "dist/",
    "scripts/migrate-v3-imports.mjs",
    "raaghu-react-themes/src/styles/index.scss",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "docs/ai/",
    "docs/TOKENS.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.stories.*",
    "!**/*.story.*",
    "!**/*.figma.*",
    "!**/.storybook/",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/stories/",
    "!**/rds-carousel-figma-slide.tsx",
    "!**/rds-file-uploader-render.tsx",
    "!**/rds-carousel-figma-slide.d.ts",
    "!**/rds-file-uploader-render.d.ts"
  ],
  "scripts": {
    "size": "size-limit",
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:lib": "vite build && npm run build:types",
    "build:types": "node scripts/emit-declarations.js",
    "type-check:declarations": "node scripts/emit-declarations.js --strict",
    "lint": "eslint . && npm run lint:scss && npm run lint:hex && npm run lint:rgba && npm run lint:important && npm run lint:spacing && npm run lint:raw-px && npm run lint:local-dim-px && npm run lint:typography-motion && npm run lint:orphaned-vars && npm run lint:ts-raw-values",
    "lint:scss": "stylelint \"raaghu-components/**/*.{scss,css}\" \"raaghu-elements/**/*.{scss,css}\" \"raaghu-layouts/**/*.{scss,css}\" \"raaghu-react-themes/**/*.{scss,css}\"",
    "lint:hex": "node scripts/check-no-hex.mjs",
    "lint:rgba": "node scripts/check-no-rgba-in-scss.mjs",
    "lint:important": "node scripts/check-no-important-in-scss.mjs",
    "lint:spacing": "node scripts/check-spacing-in-scss.mjs",
    "lint:raw-px": "node scripts/check-raw-px-in-scss.mjs",
    "lint:local-dim-px": "node scripts/check-local-dim-px-in-scss.mjs",
    "lint:typography-motion": "node scripts/check-typography-motion-in-scss.mjs",
    "lint:orphaned-vars": "node scripts/check-orphaned-css-vars.mjs",
    "lint:ts-raw-values": "node scripts/check-raw-values-in-ts.mjs",
    "docs:ai": "node scripts/generate-ai-manifest.mjs",
    "preview": "vite preview",
    "test": "jest",
    "test:consumer-smoke": "node --max-old-space-size=4096 scripts/consumer-smoke.mjs",
    "test:consumer-isolated": "node scripts/consumer-isolated.mjs",
    "test:visual": "npm run test:storybook",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:a11y": "vitest --maxWorkers=1",
    "test:storybook": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui",
    "test:storybook:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pages": "npm --workspace raaghu-pages run dev",
    "pages:dev": "npm --workspace raaghu-pages run dev",
    "pages:build": "npm --workspace raaghu-pages run build",
    "pages:lint": "npm --workspace raaghu-pages run lint",
    "pages:preview": "npm --workspace raaghu-pages run preview",
    "clean": "rimraf node_modules dist storybook-static package-lock.json",
    "clean:install": "npm run clean && npm install",
    "type-check": "tsc --noEmit --project tsconfig.library.json",
    "type-check:all": "tsc --noEmit --project tsconfig.library.json",
    "prepublishOnly": "npm run build && npm run type-check:declarations && npm test -- --ci --maxWorkers=2",
    "test:visual:all": "npm run test:storybook"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.5.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
