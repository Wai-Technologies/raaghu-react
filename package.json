{
  "name": "@waiin/raaghu-react",
  "version": "1.2.0",
  "description": "Raaghu Design System implementation with Material UI components",
  "type": "module",
  "homepage": "https://new-react.raaghu.ai",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:visual": "storybook test-runner",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=chpt_e0908206295b243",
    "chromatic:build": "npm run build-storybook && chromatic --project-token=chpt_e0908206295b243",
    "chromatic:test": "chromatic --project-token=chpt_e0908206295b243 --exit-once-uploaded",
    "pages": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; npm run dev } else { Write-Host 'No *-pages directory found' }\"",
    "pages:dev": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; npm run dev } else { Write-Host 'No *-pages directory found' }\"",
    "pages:build": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; npm run build } else { Write-Host 'No *-pages directory found' }\"",
    "pages:lint": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; npm run lint } else { Write-Host 'No *-pages directory found' }\"",
    "pages:preview": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; npm run preview } else { Write-Host 'No *-pages directory found' }\""
  },
