        "@lexical/selection",
        "react-player",
        "react-svg-worldmap",
        "lottie-react"
      ]
    },
    {
      "name": "Full ESM entry (deps + peers external)",
      "path": "dist/index.mjs",
      "import": "*",
      "limit": "350 kB",
      "ignore": [
        "clsx",
        "dompurify",
        "@emotion/react",
        "@emotion/styled",
        "@mui/icons-material",
        "@mui/material",
        "react",
        "react-dom",
        "@mui/lab",
        "@mui/x-date-pickers",
        "dayjs",
        "chart.js",
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "lexical",
        "@lexical/html",
        "@lexical/link",
        "@lexical/list",
        "@lexical/react",
        "@lexical/rich-text",
        "@lexical/selection",
        "react-player",
        "react-svg-worldmap",
        "lottie-react"
      ]
    },
    {
      "name": "Charts subpath (deps + peers external)",
      "path": "dist/charts.mjs",
      "import": "*",
      "limit": "80 kB",
      "ignore": [
        "chart.js",
        "clsx",
        "@emotion/react",
