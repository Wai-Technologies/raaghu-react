{
  "name": "@waiin/raaghu-react",
  "version": "1.3.2",
  "description": "@waiin/raaghu-react is an React based design system from Raaghu Design System built on top of MUI and Fluent UI. @waiin/raaghu-react employs React, Typescript, Vite, Millions and Storybook features to develop highly customizable UI components and pages, that provides application shells, layouts, elements, components, map and charts.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "storybook",
    "raaghu",
    "rds-generator",
    "@waiin/raaghu-react",
    "raaghu-elements-themes",
    "raaghu-components-themes",
    "raaghu-layout-themes",
    "raaghu-appshell-themes",
    "wai-technologies",
    "utility",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wai-Technologies/raaghu-react"
  },
  "author": {
    "name": "Wai Technologies",
    "email": "support@waiin.com",
    "url": "https://waiin.com"
  },
  "homepage": "https://waiin.com/raaghu-open-source-design-system",
  "license": "Apache-2.0",
  "main": "./dist/raaghu-react.umd.js",
  "module": "./dist/raaghu-react.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/raaghu-react.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/raaghu-react.es.js",
      "require": "./dist/raaghu-react.umd.js"
    },
    "./styles.css": "./dist/raaghu-react.css",
    "./raaghu-react.css": "./dist/raaghu-react.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/raaghu-react.css"
  ],
  "workspaces": [
    "raaghu-pages"
  ],
  "files": [
    "dist/",
    "raaghu-components/",
    "raaghu-elements/",
    "raaghu-layouts/",
    "raaghu-react-themes/",
    "utils/",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.stories.*",
    "!**/*.story.*",
    "!**/.storybook/",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/stories/"
  ],
  "scripts": {
    "size": "size-limit",
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:lib": "vite build && npm run build:types",
    "build:types": "node scripts/emit-declarations.js",
    "type-check:declarations": "node scripts/emit-declarations.js --strict",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:visual": "npm run test:storybook",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:storybook": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui",
    "test:storybook:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pages": "npm --workspace raaghu-pages run dev",
    "pages:dev": "npm --workspace raaghu-pages run dev",
    "pages:build": "npm --workspace raaghu-pages run build",
    "pages:lint": "npm --workspace raaghu-pages run lint",
    "pages:preview": "npm --workspace raaghu-pages run preview",
    "clean": "rimraf node_modules dist storybook-static package-lock.json",
    "clean:install": "npm run clean && npm install",
    "type-check": "tsc --noEmit",
    "type-check:all": "tsc --noEmit --project tsconfig.library.json",
    "prepublishOnly": "npm run build && npm run type-check:declarations && npm test -- --ci --maxWorkers=2",
    "test:visual:all": "npm run test:storybook"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@griffel/react": "^1.5.30",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.10.2",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "draft-js": "^0.11.7",
    "draftjs-to-html": "^0.9.1",
    "emojibase": "^16.0.0",
    "emojibase-data": "^16.0.3",
    "html-to-draftjs": "^1.5.0",
    "immutable": "^4.3.8",
    "lottie-react": "^2.4.1",
    "react-color": "^2.19.3",
    "react-datepicker": "^8.4.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-measure": "^2.5.2",
    "react-player": "^2.13.0",
    "react-router-dom": "^7.8.1",
    "react-svg-worldmap": "^2.0.0-alpha.16",
    "react-syntax-highlighter": "^15.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@figma/code-connect": "^1.3.4",
    "@griffel/vite-plugin": "^0.1.13",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-coverage": "^3.0.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/mcp": "^0.7.0",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/chart.js": "^2.9.41",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-color": "^3.0.13",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.1.6",
    "@types/react-measure": "^2.0.12",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^4.1.9",
    "@vitest/runner": "^4.1.7",
    "axe-core": "^4.8.4",
    "clsx": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.4.1",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.1",
    "ts-jest": "^29.1.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "sass-embedded": "npm:sass@^1.89.2",
    "react-draft-wysiwyg": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "size-limit": [
    {
      "name": "Elements (all)",
      "path": "raaghu-elements/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Components (all)",
      "path": "raaghu-components/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Themes",
      "path": "raaghu-react-themes/tokens/design-tokens.ts",
      "limit": "50 kB",
      "import": "*"
    }
  ]
}
