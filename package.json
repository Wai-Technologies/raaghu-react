    "axe-core": "^4.8.4",
    "chart.js": "^4.6.2",
    "dayjs": "^1.11.23",
    "emojibase": "^16.0.0",
    "emojibase-data": "^16.0.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lexical": "~0.53.0",
