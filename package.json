    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/lab": "^7.0.1-beta.25",
    "@mui/x-date-pickers": "^8.10.0",
    "dayjs": "^1.11.13",
    "chart.js": "^4.5.0",
    "@dnd-kit/core": "^6.3.1",
