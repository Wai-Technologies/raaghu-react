    "@dnd-kit/utilities": "^3.2.2",
    "lexical": "~0.53.0",
    "@lexical/html": "~0.53.0",
    "@lexical/link": "~0.53.0",
    "@lexical/list": "~0.53.0",
    "@lexical/react": "~0.53.0",
