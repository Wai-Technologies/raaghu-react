  "size-limit": [
    {
      "name": "RdsButton only (tree-shaken, deps + peers external)",
      "path": "dist/index.mjs",
      "import": "{ RdsButton }",
      "limit": "10 kB",
      "ignore": [
        "clsx",
        "dompurify",
        "@emotion/react",
        "@emotion/styled",
        "@mui/icons-material",
        "@mui/material",
        "react",
        "react-dom",
