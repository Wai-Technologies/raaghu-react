{
  "name": "@waiin/raaghu-react",
  "version": "2.0.0",
  "description": "@waiin/raaghu-react is a React design system from the Raaghu Design System, built on MUI. It uses React, TypeScript, Vite and Storybook to provide customizable application shells, layouts, elements, components, maps and charts.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "storybook",
    "raaghu",
    "rds-generator",
    "@waiin/raaghu-react",
    "raaghu-elements-themes",
    "raaghu-components-themes",
    "raaghu-layout-themes",
    "raaghu-appshell-themes",
    "wai-technologies",
    "utility",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wai-Technologies/raaghu-react"
  },
  "author": {
    "name": "Wai Technologies",
    "email": "support@waiin.com",
    "url": "https://waiin.com"
  },
  "homepage": "https://waiin.com/raaghu-open-source-design-system",
  "license": "Apache-2.0",
  "main": "./dist/raaghu-react.cjs",
  "module": "./dist/raaghu-react.es.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/raaghu-react.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/raaghu-react.es.mjs",
      "require": "./dist/raaghu-react.cjs"
    },
    "./styles.css": "./dist/raaghu-react.css",
    "./raaghu-react.css": "./dist/raaghu-react.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/raaghu-react.css"
  ],
  "workspaces": [
    "raaghu-pages"
  ],
  "files": [
    "dist/",
    "raaghu-components/",
    "raaghu-elements/",
    "raaghu-layouts/",
    "raaghu-react-themes/",
    "utils/",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.stories.*",
    "!**/*.story.*",
    "!**/*.figma.*",
    "!**/.storybook/",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/stories/",
    "!**/rds-carousel-figma-slide.tsx",
    "!**/rds-file-uploader-render.tsx",
    "!**/rds-carousel-figma-slide.d.ts",
    "!**/rds-file-uploader-render.d.ts"
  ],
  "scripts": {
    "size": "size-limit",
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:lib": "vite build && npm run build:types",
    "build:types": "node scripts/emit-declarations.js",
    "type-check:declarations": "node scripts/emit-declarations.js --strict",
    "lint": "eslint . && npm run lint:scss && npm run lint:hex && npm run lint:rgba && npm run lint:spacing && npm run lint:raw-px && npm run lint:local-dim-px && npm run lint:orphaned-vars",
    "lint:scss": "stylelint \"raaghu-components/**/*.{scss,css}\" \"raaghu-elements/**/*.{scss,css}\" \"raaghu-layouts/**/*.{scss,css}\" \"raaghu-react-themes/**/*.{scss,css}\"",
    "lint:hex": "node scripts/check-no-hex.mjs",
    "lint:rgba": "node scripts/check-no-rgba-in-scss.mjs",
    "lint:spacing": "node scripts/check-spacing-in-scss.mjs",
    "lint:raw-px": "node scripts/check-raw-px-in-scss.mjs",
    "lint:local-dim-px": "node scripts/check-local-dim-px-in-scss.mjs",
    "lint:orphaned-vars": "node scripts/check-orphaned-css-vars.mjs",
    "preview": "vite preview",
    "test": "jest",
    "test:visual": "npm run test:storybook",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:storybook": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui",
    "test:storybook:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pages": "npm --workspace raaghu-pages run dev",
    "pages:dev": "npm --workspace raaghu-pages run dev",
    "pages:build": "npm --workspace raaghu-pages run build",
    "pages:lint": "npm --workspace raaghu-pages run lint",
    "pages:preview": "npm --workspace raaghu-pages run preview",
    "clean": "rimraf node_modules dist storybook-static package-lock.json",
    "clean:install": "npm run clean && npm install",
    "type-check": "tsc --noEmit --project tsconfig.library.json",
    "type-check:all": "tsc --noEmit --project tsconfig.library.json",
    "prepublishOnly": "npm run build && npm run type-check:declarations && npm test -- --ci --maxWorkers=2",
    "test:visual:all": "npm run test:storybook"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "draft-js": "^0.11.7",
    "draftjs-to-html": "^0.9.1",
    "emojibase": "^16.0.0",
    "emojibase-data": "^16.0.3",
    "html-to-draftjs": "^1.5.0",
    "immutable": "^4.3.8",
    "lottie-react": "^2.4.1",
    "react-datepicker": "^8.4.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-player": "^3.4.0",
    "react-svg-worldmap": "^2.3.0",
    "react-syntax-highlighter": "^16.1.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.30.1",
    "@figma/code-connect": "^1.3.4",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.10.2",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-coverage": "^3.0.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/mcp": "^0.7.0",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^4.1.9",
    "@vitest/runner": "^4.1.7",
    "axe-core": "^4.8.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.4.1",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss-scss": "^4.0.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.8.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.14.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "sass-embedded": "npm:sass@^1.89.2",
    "zod-validation-error": "^4.0.0",
    "react-draft-wysiwyg": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "@mui/x-date-pickers": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "size-limit": [
    {
      "name": "Elements (all)",
      "path": "raaghu-elements/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Components (all)",
      "path": "raaghu-components/index.ts",
      "limit": "500 kB",
      "import": "*"
    },
    {
      "name": "Themes",
      "path": "raaghu-react-themes/tokens/design-tokens.ts",
      "limit": "50 kB",
      "import": "*"
    }
  ]
}
