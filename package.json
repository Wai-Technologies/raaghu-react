{
  "name": "@waiin/raaghu-react",
  "version": "1.3.0",
  "description": "@waiin/raaghu-react is an React based design system from Raaghu Design System built on top of MUI and Fluent UI. @waiin/raaghu-react employs React, Typescript, Vite, Millions and Storybook features to develop highly customizable UI components and pages, that provides application shells, layouts, elements, components, map and charts.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "millionjs",
    "bootstrap",
    "storybook",
    "raaghu",
    "rds-generator",
    "@waiin/raaghu-react",
    "raaghu-elements-themes",
    "raaghu-components-themes",
    "raaghu-layout-themes",
    "raaghu-appshell-themes",
    "wai-technologies",
    "utility",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wai-Technologies/raaghu-react"
  },
  "author": {
    "name": "Wai Technologies",
    "email": "support@waiin.com",
    "url": "https://waiin.com"
  },
  "homepage": "https://waiin.com/raaghu-open-source-design-system",
  "license": "Apache License 2.0",
  "files": [
    "raaghu-components/",
    "raaghu-elements/",
    "raaghu-layouts/",
    "raaghu-pages/",
    "raaghu-react-themes/",
    "utils/",
    "index.ts",
    "README.md",
    "LICENSE",
    "!**/*.stories.*",
    "!**/*.story.*",
    "!**/.storybook/",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/stories/"
  ],
  "scripts": {
    "dev": "bun run vite",
    "build": "bun run tsc -b && bun run vite build",
    "lint": "bun run eslint .",
    "preview": "bun run vite preview",
    "test": "bun run jest",
    "test:watch": "bun run jest --watch",
    "test:coverage": "bun run jest --coverage",
    "test:accessibility": "bun run jest --testPathPattern=accessibility",
    "test:visual": "storybook test-runner",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "bun run chromatic --project-token=chpt_e0908206295b243",
    "chromatic:build": "npm run build-storybook && bun run chromatic --project-token=chpt_e0908206295b243",
    "chromatic:test": "bun run chromatic --project-token=chpt_e0908206295b243 --exit-once-uploaded",
    "pages": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; bun run dev } else { Write-Host 'No *-pages directory found' }\"",
    "pages:dev": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; bun run dev } else { Write-Host 'No *-pages directory found' }\"",
    "pages:build": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; bun run build } else { Write-Host 'No *-pages directory found' }\"",
    "pages:lint": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; bun run lint } else { Write-Host 'No *-pages directory found' }\"",
    "pages:preview": "powershell -c \"$pagesDir = Get-ChildItem -Directory -Name '*-pages' | Select-Object -First 1; if ($pagesDir) { Set-Location $pagesDir; bun run preview } else { Write-Host 'No *-pages directory found' }\"",
    "install:bun": "bun install",
    "clean": "bun run rimraf node_modules dist storybook-static bun.lock",
    "clean:install": "bun run clean && bun install",
    "type-check": "bun run tsc --noEmit"
  },
  "dependencies": {
