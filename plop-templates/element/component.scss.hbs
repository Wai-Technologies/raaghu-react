.rds-{{kebabCase name}} {
  display: inline-flex;
  align-items: center;
  gap: var(--rds-spacing-xs);
  font-family: var(--rds-font-family-base);
  font-size: var(--rds-font-size-md);
  color: var(--rds-text-primary);
  background-color: var(--rds-background-default);
  border-radius: var(--rds-radius-base);
  transition: var(--rds-motion-transition-fast);
  cursor: default;

  &--small  { padding: var(--rds-spacing-xxs) var(--rds-spacing-xs); font-size: var(--rds-font-size-sm); }
  &--medium { padding: var(--rds-spacing-xs) var(--rds-spacing-sm);  font-size: var(--rds-font-size-md); }
  &--large  { padding: var(--rds-spacing-sm) var(--rds-spacing-md);  font-size: var(--rds-font-size-lg); }

  &[role='button'] {
    cursor: pointer;
    &:hover       { background-color: var(--rds-action-hover); }
    &:focus-visible { outline: 2px solid var(--rds-primary-main); outline-offset: 2px; }
  }

  &--disabled { opacity: 0.4; pointer-events: none; }

  &__label {
    font-weight: var(--rds-font-weight-medium);
    line-height: var(--rds-line-height-normal);
  }
}
