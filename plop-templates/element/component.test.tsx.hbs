import React from 'react';
import { render, screen, fireEvent } from '@testing-library/react';
import Rds{{pascalCase name}}, { Rds{{pascalCase name}}Props } from './rds-{{kebabCase name}}';
import '@testing-library/jest-dom';
import { axe } from 'jest-axe';

jest.mock('./rds-{{kebabCase name}}.scss', () => ({}));

describe('Rds{{pascalCase name}}', () => {
  const defaultProps: Rds{{pascalCase name}}Props = {
    label: 'Test {{pascalCase name}}',
    size: 'medium',
  };

  describe('Basic Rendering', () => {
    it('should render component without crashing', () => {
      const { container } = render(<Rds{{pascalCase name}} {...defaultProps} />);
      expect(container.querySelector('.rds-{{kebabCase name}}')).toBeInTheDocument();
    });

    it('should have correct displayName', () => {
      expect(Rds{{pascalCase name}}.displayName).toBe('Rds{{pascalCase name}}');
    });

    it('should render label text', () => {
      render(<Rds{{pascalCase name}} label="Hello" />);
      expect(screen.getByText('Hello')).toBeInTheDocument();
    });

    it('should render children', () => {
      render(<Rds{{pascalCase name}}>Child content</Rds{{pascalCase name}}>);
      expect(screen.getByText('Child content')).toBeInTheDocument();
    });

    it('should apply custom className', () => {
      const { container } = render(<Rds{{pascalCase name}} className="custom" />);
      expect(container.querySelector('.rds-{{kebabCase name}}.custom')).toBeInTheDocument();
    });
  });

  describe('Size Variants', () => {
    it('should apply medium class by default', () => {
      const { container } = render(<Rds{{pascalCase name}} {...defaultProps} />);
      expect(container.querySelector('.rds-{{kebabCase name}}--medium')).toBeInTheDocument();
    });

    it('should apply small class', () => {
      const { container } = render(<Rds{{pascalCase name}} size="small" />);
      expect(container.querySelector('.rds-{{kebabCase name}}--small')).toBeInTheDocument();
    });

    it('should apply large class', () => {
      const { container } = render(<Rds{{pascalCase name}} size="large" />);
      expect(container.querySelector('.rds-{{kebabCase name}}--large')).toBeInTheDocument();
    });
  });

  describe('Disabled State', () => {
    it('should apply disabled class', () => {
      const { container } = render(<Rds{{pascalCase name}} disabled />);
      expect(container.querySelector('.rds-{{kebabCase name}}--disabled')).toBeInTheDocument();
    });

    it('should not fire onClick when disabled', () => {
      const onClick = jest.fn();
      const { container } = render(<Rds{{pascalCase name}} disabled onClick={onClick} />);
      fireEvent.click(container.querySelector('.rds-{{kebabCase name}}')!);
      expect(onClick).not.toHaveBeenCalled();
    });
  });

  describe('Interaction', () => {
    it('should fire onClick when clicked', () => {
      const onClick = jest.fn();
      const { container } = render(<Rds{{pascalCase name}} onClick={onClick} />);
      fireEvent.click(container.querySelector('.rds-{{kebabCase name}}')!);
      expect(onClick).toHaveBeenCalledTimes(1);
    });

    it('should have role="button" when onClick provided', () => {
      const { container } = render(<Rds{{pascalCase name}} onClick={jest.fn()} />);
      expect(container.querySelector('[role="button"]')).toBeInTheDocument();
    });
  });

  describe('Accessibility', () => {
    it('has no axe accessibility violations', async () => {
      const { container } = render(<Rds{{pascalCase name}} {...defaultProps} />);
      const results = await axe(container);
      expect(results).toHaveNoViolations();
    });
  });
});
