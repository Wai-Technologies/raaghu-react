{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "noEmitOnError": false
  },
  "include": [
    "global.d.ts",
    "types",
    "index.ts",
    "raaghu-elements",
    "raaghu-components",
    "raaghu-layouts",
    "raaghu-react-themes",
    "utils"
  ],
  "exclude": [
    "**/*.stories.*",
    "**/*.story.*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.figma.*",
    "raaghu-components/rds-comp-tree-structure/**",
    "raaghu-components/rds-comp-adaptive-cards/**",
    "raaghu-components/rds-comp-chat/**",
    "raaghu-components/rds-comp-code-snippet/**",
    "raaghu-components/rds-comp-comments-box/**",
    "raaghu-components/rds-comp-details-pane/**",
    "raaghu-components/rds-comp-navtabs/**",
    "raaghu-components/rds-comp-grid/**",
    "raaghu-components/rds-comp-date-and-time-picker/**"
  ]
}
